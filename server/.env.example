# server/.env — read by the app (dev and production; the server always loads
# this file from its CWD). Copy to server/.env and adjust. scripts/deploy.ps1
# generates one with a random JWT_SECRET if it is missing.

# Server
PORT=3021
# Comma-separated allowed origins for CORS (frontend dev server)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file path
DB_PATH=./data/uptime.db

# Secret used to sign JWT auth tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- STAP logged-user extraction (http-ping monitors only) ---
# Reads the full remote console log of an http-ping monitor's host on demand
# (via the "Check users" button) and shows the currently logged-in users on the
# monitor card. There is no background polling — the log is read only when asked.

# Enable/disable the feature. Default: true.
STAP_LOG_ENABLED=true

# Path to the remote log file. {host} is replaced with the monitor's hostname.
# Default uses the C$ admin share (needs admin rights OR the credentials below).
# For a dedicated read-only share instead, use e.g. \\{host}\stibslog\log_backend_0.log
STAP_LOG_UNC=\\{host}\C$\Users\stibs\AppData\Roaming\stibs\portable\base\module\logging\log_backend_0.log

# Optional Windows credentials to authenticate the SMB session to each host,
# so the server account does not need access itself. Leave empty to use the
# server's own identity. User may be "DOMAIN\user", "user@domain" or "user".
# The "Restart" card button reuses these same credentials over WMI.
# Keep real values only in .env (gitignored), never here.
STAP_LOG_USER=
STAP_LOG_PASSWORD=

# --- STAP program restart (http-ping monitors only) ---
# Local path, on the remote host, of the STAP backend executable that the card
# "Restart" button stops and starts again (via WMI, reusing the credentials
# above). Not a UNC path — it is the path as seen on the monitored machine.
STAP_EXE_PATH=C:\Users\stibs\AppData\Roaming\stibs\portable\base\module\backend\STAP_Stibs2.exe
